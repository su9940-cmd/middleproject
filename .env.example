# 이 파일을 복사해 .env로 저장하고 실제 값을 채우세요. .env는 .gitignore에 있어 커밋되지 않습니다.

# SQLAlchemy 비동기 DB URL. 기본값은 로컬 SQLite 파일이라 별도 설정 없이도 실행됩니다.
# Postgres로 옮길 때는 예: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./safety_app.db

# industrial_fire_custom_accident_ml.ipynb가 생성하는 학습된 모델 아티팩트 경로
# (data/models/ 이하는 gitignore 대상이라 노트북을 먼저 실행해 생성해야 합니다).
MODEL_PIPELINE_PATH=models/industrial_fire_accident_pipeline.joblib
MODEL_METADATA_PATH=models/industrial_fire_accident_metadata.json

# risk_policy가 반환하는 policy_version 값(계약 8절) - 임계값/긴급 규칙을 바꿀 때 올리세요.
RISK_POLICY_VERSION=risk-policy-v1

# RAG/Chroma runtime settings
RAG_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
RAG_CHROMA_PATH=chroma_db
RAG_CHROMA_COLLECTION_NAME=safety_documents__section
RAG_DEFAULT_TOP_K=5

# send_immediate_alert(app/nodes/notification.py)가 EMERGENCY 알림을 보낼 Slack
# Incoming Webhook URL. 비어 있으면 알림 발송이 실패로 처리되지만(notification_status=
# FAILED), RAG/Memory/체크리스트 생성 경로는 계속 진행됩니다(계약 8절).
SLACK_ALERT_WEBHOOK_URL=
